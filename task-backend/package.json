{
	"name": "task-backend",
	"version": "1.0.0",
	"description": "Quality Inspection Tracker REST API (Express + TypeScript + SQLite)",
	"private": true,
	"type": "module",
	"main": "dist/server.js",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"db:migrate": "tsx src/scripts/migrate.ts",
		"db:seed": "tsx src/scripts/seed.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"better-sqlite3": "^13.0.3",
		"cors": "^2.8.6",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-serve-static-core": "^5.1.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.5",
		"@types/supertest": "^7.2.1",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"better-sqlite3": false,
		"esbuild": true
	}
}
